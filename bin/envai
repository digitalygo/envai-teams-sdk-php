#!/usr/bin/env php
<?php

declare(strict_types=1);

use Digitalygo\Envai\Support\ConsoleBootstrap;
use Digitalygo\Envai\Sync\Console\DefinitionsPlanCommand;
use Digitalygo\Envai\Sync\Console\DefinitionsStateCommand;
use Digitalygo\Envai\Sync\Console\DefinitionsStatusCommand;
use Digitalygo\Envai\Sync\Console\DefinitionsSyncCommand;
use Digitalygo\Envai\Sync\Console\DefinitionsValidateCommand;
use Symfony\Component\Console\Application;

$autoloadCandidates = [
    __DIR__.'/../vendor/autoload.php',
    __DIR__.'/../../../autoload.php',
];

$autoloaded = false;

foreach ($autoloadCandidates as $autoload) {
    if (is_file($autoload)) {
        require $autoload;
        $autoloaded = true;

        break;
    }
}

if (! $autoloaded) {
    fwrite(STDERR, 'Unable to locate the Composer autoloader. Run `composer install` first.'.PHP_EOL);
    exit(1);
}

$application = new Application('Envai ATP PHP SDK', '0.1.0');

/*
 * Command registry.
 *
 * Every command receives the same definitions factory closure so tests
 * can inject a fake wiring; the production factory builds the client
 * from the environment (see ConsoleBootstrap::definitionsFactory()).
 */
$factory = ConsoleBootstrap::definitionsFactory();

$commands = [
    new DefinitionsValidateCommand($factory),
    new DefinitionsPlanCommand($factory),
    new DefinitionsSyncCommand($factory),
    new DefinitionsStatusCommand($factory),
    new DefinitionsStateCommand($factory),
];

$application->addCommands($commands);

$application->run();
